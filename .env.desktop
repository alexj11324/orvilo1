# Orvilo Desktop Development Environment Configuration
# ⚠️ Development values only — do not reuse in production builds.
#
# Copy this file to `.env` when you want to develop the desktop app or you will fail.
# `.env.desktop` is loaded for desktop builds via `node -r ./scripts/registerDesktopEnv.cjs`.
#
# Required-vs-optional convention:
#   - "Required:" lines under each section name the variables the desktop dev
#     flow needs; everything else is optional.

# #######################################
# ######### Application & Ports ##########
# #######################################
# Required: APP_URL

# Base URL the desktop shell loads the web app from
APP_URL=http://localhost:3015

# Optional: server-to-server base URL that bypasses CDN/proxy for internal
# calls (workflows, hooks). Falls back to APP_URL when unset.
# INTERNAL_APP_URL=http://localhost:3015

# Feature flag overrides for the desktop build
FEATURE_FLAGS=-check_updates,+pin_list

# #######################################
# ######### Auth & Key-Vault #############
# #######################################
# Required: KEY_VAULTS_SECRET

# Key-vault encryption secret (development value, generate your own for real deployments)
KEY_VAULTS_SECRET=oLXWIiR/AKF+rWaqy9lHkrYgzpATbW3CtJp3UfkVgpE=

# #######################################
# ######### Server Database ##############
# #######################################
# Required: DATABASE_URL

DATABASE_URL=postgresql://postgres@localhost:5432/postgres

# #######################################
# ######## Search & Mock Services ########
# #######################################
# Optional

SEARCH_PROVIDERS=search1api

# #######################################
# ########### Desktop Build ##############
# #######################################
# Required for desktop builds

DESKTOP_BUILD=true
