/** Generic proof of literal document grammar and a closed text consumer.
 * Evidence entrypoints locate real callers; no owner/name/SHA exception qualifies a fence.
 */
import assert from 'node:assert/strict';
import path from 'node:path';
export function createDocumentGrammarAudit({ts,mdxParser,sha,readGitSource,evidence}) {
 const documents=[],consumerContexts=[],moduleCache=new Map(),contextCache=new Map(),compilerCache=new Map(),typedReceiverCache=new WeakMap();
 const children=(node,fn)=>{fn(node);ts.forEachChild(node,n=>children(n,fn));};
 const literal=n=>n&&(ts.isStringLiteral(n)||ts.isNoSubstitutionTemplateLiteral(n))?n.text:null;
 const unwrap=n=>ts.isAwaitExpression(n)?n.expression:n;
 function module(ref,file){const record=readGitSource(ref,file);assert(record,'Missing exact consumer module: '+file);const key=file+':'+sha(record.text)+':'+record.gitMode;if(moduleCache.has(key))return{...moduleCache.get(key),ref};const sf=ts.createSourceFile('/workspace/orvilo1/'+file,record.text,ts.ScriptTarget.Latest,true,/tsx$/.test(file)?ts.ScriptKind.TSX:ts.ScriptKind.TS);assert.equal(sf.parseDiagnostics.length,0,'Whole consumer source parse rejected');const value={...record,sf,file,ref};moduleCache.set(key,value);return value;}
 function imported(m,name){let result=null;for(const node of m.sf.statements)if(ts.isImportDeclaration(node)&&node.importClause){const clause=node.importClause,bindings=clause.namedBindings;if(bindings&&ts.isNamespaceImport(bindings)&&bindings.name.text===name)result={source:literal(node.moduleSpecifier),namespace:true};if(bindings&&ts.isNamedImports(bindings))for(const item of bindings.elements)if(item.name.text===name)result={source:literal(node.moduleSpecifier),name:item.propertyName?.text??item.name.text,namespace:false};}return result;}
 function importedModule(m,name){const imp=imported(m,name);assert(imp&&!imp.namespace&&imp.source.startsWith('.'),'Function consumer must have an exact relative named import');const base=path.posix.normalize(path.posix.join(path.posix.dirname(m.file),imp.source));const candidates=[base,base+'.ts',base+'.tsx',base+'.js',base+'/index.ts',base+'/index.tsx'];const found=candidates.flatMap(file=>{const data=readGitSource(m.ref,file);return data?[file]:[];});assert.equal(found.length,1,'Missing/ambiguous exact import module');return{module:module(m.ref,found[0]),name:imp.name};}
 function definition(m,name){const found=[];for(const statement of m.sf.statements){if(ts.isFunctionDeclaration(statement)&&statement.name?.text===name)found.push(statement);if(ts.isVariableStatement(statement))for(const d of statement.declarationList.declarations)if(ts.isIdentifier(d.name)&&d.name.text===name&&d.initializer&&(ts.isArrowFunction(d.initializer)||ts.isFunctionExpression(d.initializer)))found.push(d.initializer);}assert.equal(found.length,1,'Exact named consumer function missing/ambiguous');return found[0];}
 function singleReturnCall(fn){assert(fn.parameters.length&&ts.isIdentifier(fn.parameters[0].name));const body=fn.body;const expression=ts.isBlock(body)?(assert.equal(body.statements.length,1,'Unexpected extra text-consumer statements'),assert(ts.isReturnStatement(body.statements[0])),body.statements[0].expression):body;const call=unwrap(expression);assert(ts.isCallExpression(call)&&ts.isIdentifier(call.expression)&&ts.isIdentifier(call.arguments[0])&&call.arguments[0].text===fn.parameters[0].name.text,'Document text is not passed directly to the exact consumer');return call;}
 function staticConstant(m,node,seen=new Set(),sources=new Map()){sources.set(m.file,m);while(ts.isParenthesizedExpression(node)||ts.isAsExpression(node)||ts.isNonNullExpression(node)||ts.isSatisfiesExpression(node))node=node.expression;if(literal(node)!==null||ts.isNumericLiteral(node)||[ts.SyntaxKind.TrueKeyword,ts.SyntaxKind.FalseKeyword,ts.SyntaxKind.NullKeyword].includes(node.kind))return{kind:'PRIMITIVE_LITERAL',source:node.getText(m.sf)};if(ts.isArrayLiteralExpression(node))return{kind:'STATIC_ARRAY',items:node.elements.map(n=>staticConstant(m,n,seen,sources))};if(ts.isObjectLiteralExpression(node))return{kind:'STATIC_OBJECT',properties:node.properties.map(p=>{assert(ts.isPropertyAssignment(p)&&!ts.isComputedPropertyName(p.name),'Getter/method/spread or dynamic configuration not proven');return{name:p.name.getText(m.sf),value:staticConstant(m,p.initializer,seen,sources)};})};if(ts.isIdentifier(node)){const key=m.file+':'+node.text;assert(!seen.has(key),'Cyclic configuration');const next=new Set(seen);next.add(key);const imp=imported(m,node.text);if(imp){const target=importedModule(m,node.text);const declaration=[];for(const st of target.module.sf.statements)if(ts.isVariableStatement(st))for(const d of st.declarationList.declarations)if(ts.isIdentifier(d.name)&&d.name.text===target.name)declaration.push(d);assert.equal(declaration.length,1);assert(declaration[0].parent.flags&ts.NodeFlags.Const);return staticConstant(target.module,declaration[0].initializer,next,sources);}const declarations=[];for(const st of m.sf.statements)if(ts.isVariableStatement(st))for(const d of st.declarationList.declarations)if(ts.isIdentifier(d.name)&&d.name.text===node.text)declarations.push(d);assert.equal(declarations.length,1);assert(declarations[0].parent.flags&ts.NodeFlags.Const);return staticConstant(m,declarations[0].initializer,next,sources);}if(ts.isCallExpression(node)&&ts.isIdentifier(node.expression)&&node.arguments.length===0){const fn=definition(m,node.expression.text);assert.equal(fn.parameters.length,0);let value=fn.body;if(ts.isBlock(value)){assert.equal(value.statements.length,1);assert(ts.isReturnStatement(value.statements[0]));value=value.statements[0].expression;}return staticConstant(m,value,seen,sources);}throw new Error('Unknown evaluating configuration expression');}
 function typedStringReceivers(m){if(typedReceiverCache.has(m.sf))return typedReceiverCache.get(m.sf);const options={target:ts.ScriptTarget.ES2022,module:ts.ModuleKind.ESNext,noEmit:true,skipLibCheck:true,types:[],lib:['lib.es2022.d.ts']},host=ts.createCompilerHost(options,true),defaultRead=host.readFile,defaultExists=host.fileExists,libraryFiles=new Map();
  const originalGet=host.getSourceFile;host.fileExists=file=>file.startsWith('/workspace/orvilo1/')&&!file.includes('/node_modules/')?Boolean(readGitSource(m.ref,path.posix.relative('/workspace/orvilo1',file))):defaultExists(file);host.readFile=file=>file.startsWith('/workspace/orvilo1/')&&!file.includes('/node_modules/')?readGitSource(m.ref,path.posix.relative('/workspace/orvilo1',file))?.text:defaultRead(file);
  host.getSourceFile=(file,languageVersion,onError)=>{if(file===m.sf.fileName)return m.sf;if(file.startsWith('/workspace/orvilo1/')&&!file.includes('/node_modules/')){const data=readGitSource(m.ref,path.posix.relative('/workspace/orvilo1',file));return data?ts.createSourceFile(file,data.text,languageVersion,true):undefined;}const result=originalGet(file,languageVersion,onError);if(result&&/[/\\]lib\.[^/\\]+\.d\.ts$/.test(file))libraryFiles.set(file,{file,fullSHA256:sha(result.text),bytes:Buffer.byteLength(result.text)});return result;};
  const program=ts.createProgram([m.sf.fileName],options,host),checker=program.getTypeChecker();const value={checker,libraryFiles};typedReceiverCache.set(m.sf,value);return value;
 }
 function closedStringSplitter(m,entryName){const names=new Map();for(const statement of m.sf.statements)if(ts.isFunctionDeclaration(statement)&&statement.name)names.set(statement.name.text,statement);const reachable=[],seen=new Set(),types=typedStringReceivers(m);const methods=new Set(['at','includes','split','push','join','shift','map','indexOf','slice','filter','flatMap']);
  function visitName(name){assert(names.has(name),'Unknown function in text splitter: '+name);if(seen.has(name))return;seen.add(name);const fn=names.get(name);const localBindings=new Set();children(fn,node=>{if((ts.isParameter(node)||ts.isVariableDeclaration(node))&&ts.isIdentifier(node.name))localBindings.add(node.name.text);});reachable.push({name,source:fn.getText(m.sf),rangeUtf16:[fn.getStart(m.sf),fn.end]});children(fn,node=>{assert(!ts.isNewExpression(node),'Unknown constructor in documentary consumer');if(!ts.isCallExpression(node))return;const callee=node.expression;if(ts.isIdentifier(callee)){visitName(callee.text);return;}assert(ts.isPropertyAccessExpression(callee),'Computed/dynamic consumer call not proven');if(ts.isIdentifier(callee.expression)&&callee.expression.text==='Math'){assert(['min','max','floor','ceil'].includes(callee.name.text));return;}assert(methods.has(callee.name.text),'Unknown code-evaluating consumer method: '+callee.name.text);assert(ts.isIdentifier(callee.expression)&&localBindings.has(callee.expression.text)&&!imported(m,callee.expression.text),'Unknown/imported method receiver in documentary consumer');const receiverType=types.checker.getTypeAtLocation(callee.expression),isString=Boolean(receiverType.flags&ts.TypeFlags.StringLike),isStringArray=types.checker.isArrayType(receiverType)&&types.checker.getTypeArguments(receiverType).every(x=>Boolean(x.flags&ts.TypeFlags.StringLike));assert(isString||isStringArray,'Unknown code-evaluating object receiver; genuine publicTS type is not string/string[]');if(['map','filter','flatMap'].includes(callee.name.text))assert(ts.isArrowFunction(node.arguments[0])||ts.isFunctionExpression(node.arguments[0]),'Unknown callback transform in documentary consumer');});}
  visitName(entryName);return{functions:reachable,publicStringReceiverTypeEvidence:true,publicTypeScriptStandardLibraryBindings:[...types.libraryFiles.values()],wholeProgramTypeEqualityOrAcceptanceClaimed:false};
 }
 function context(file,ref){const key=ref+':'+file;if(contextCache.has(key))return contextCache.get(key);const attempts=[];let result=null;
  for(const entry of evidence.consumerEntrypoints){try{const caller=module(ref,entry),reads=[];children(caller.sf,node=>{if(!ts.isVariableDeclaration(node)||!ts.isIdentifier(node.name)||!node.initializer)return;const init=unwrap(node.initializer);if(!ts.isCallExpression(init)||!ts.isPropertyAccessExpression(init.expression)||init.expression.name.text!=='readFileSync'||!ts.isIdentifier(init.expression.expression))return;const fs=imported(caller,init.expression.expression.text);if(fs?.source!=='node:fs'||!fs.namespace||literal(init.arguments[1])!=='utf8')return;const join=init.arguments[0];if(!ts.isCallExpression(join)||!ts.isIdentifier(join.expression)||(imported(caller,join.expression.text)?.source!=='node:path'||imported(caller,join.expression.text)?.name!=='join')||!ts.isIdentifier(join.arguments[0])||join.arguments[0].text!=='__dirname'||literal(join.arguments[1])===null||join.arguments.length!==2)return;const resolved=path.posix.normalize(path.posix.join(path.posix.dirname(entry),literal(join.arguments[1])));if(resolved!==file)return;assert(node.parent.flags&ts.NodeFlags.Const,'Document bytes are not held in an immutable binding');reads.push({name:node.name.text,node});});
    for(const read of reads){const calls=[];children(caller.sf,node=>{if(ts.isCallExpression(node)&&ts.isIdentifier(node.arguments[0])&&node.arguments[0].text===read.name)calls.push(node);});assert.equal(calls.length,1,'Missing/ambiguous/additional evaluating consumer of document bytes');const call=calls[0];const allNamedUses=[];children(caller.sf,node=>{if(ts.isIdentifier(node)&&node.text===read.name)allNamedUses.push(node);});assert.equal(allNamedUses.length,2,'Unknown additional or shadowed reader-byte binding use, including a nonfirst argument');assert(allNamedUses.includes(read.node.name)&&allNamedUses.includes(call.arguments[0]),'Exact reader byte binding uses are not the declaration and sole consumer argument');assert(ts.isIdentifier(call.expression));const loader=importedModule(caller,call.expression.text),loaderFn=definition(loader.module,loader.name),forward=singleReturnCall(loaderFn),splitter=importedModule(loader.module,forward.expression.text),splitterFn=definition(splitter.module,splitter.name),splitterForward=singleReturnCall(splitterFn),closure=closedStringSplitter(splitter.module,splitterForward.expression.text);const configSources=new Map(),configurationProofs=[staticConstant(loader.module,forward.arguments[1],new Set(),configSources),staticConstant(splitter.module,splitterForward.arguments[1],new Set(),configSources)];
     result={kind:'EXACT_PUBLIC_TS_CLOSED_UTF8_DOCUMENT_TEXT_CONSUMER',file,ref,entrypoint:entry,sourceOwnerReadRangeUtf16:[read.node.getStart(caller.sf),read.node.end],directConsumerCallRangeUtf16:[call.getStart(caller.sf),call.end],loaderFunction:loader.name,splitterFunction:splitter.name,reachableStringFunctions:closure,configurationProofs,sources:[caller,loader.module,splitter.module,...configSources.values()].filter((x,i,a)=>a.findIndex(y=>y.file===x.file)===i).map(x=>({file:x.file,ref:x.ref,gitBlob:x.gitBlob,gitMode:x.gitMode,wholeSHA256:sha(x.text),fullSource:x.text})),customCodeEvaluatingTransforms:false};break;
    }
   }catch(error){attempts.push({entrypoint:entry,error:String(error.message)});}if(result)break;
  }
  const row=result??{kind:'HOLD_UNKNOWN_DOCUMENT_CONSUMER_OR_CODE_EVALUATING_TRANSFORM',file,ref,attempts,customCodeEvaluatingTransformsProvenAbsent:false};consumerContexts.push(row);contextCache.set(key,row);return row;
 }
 function compiledLiteralProof(text){const key=sha(text);if(compilerCache.has(key))return compilerCache.get(key);const compiled=String(mdxParser.compileSync(text,{format:'mdx',outputFormat:'program'}));const sf=ts.createSourceFile('actual-document-compiler-output.js',compiled,ts.ScriptTarget.Latest,true,ts.ScriptKind.JS);assert.equal(sf.parseDiagnostics.length,0,'Actual public MDX compiler output rejected');const values=[];children(sf,node=>{if(ts.isStringLiteral(node)||ts.isNoSubstitutionTemplateLiteral(node))values.push(node.text);});const row={wholeOwnerSHA256:key,fullActualCompiledProgram:compiled,actualCompiledProgramSHA256:sha(compiled),actualCompiledProgramBytes:Buffer.byteLength(compiled),actualGeneratedJSParseDiagnostics:[],wholeGeneratedStringLiteralValues:values,customTransformOptions:[]};compilerCache.set(key,row);return row;}
 function fence({file,text,node,address,phase,syntheticDiagnostics,retainedSlots}){
  const ownerSHA256=sha(text),rawSpan=node.position?text.slice(node.position.start.offset,node.position.end.offset):null,body=node.value,rawNumbers=[];for(const match of text.matchAll(/[0-9]+(?:\.[0-9]+)?/g)){const prefix=text.slice(0,match.index);rawNumbers.push({rawText:match[0],parentRangeUtf16:[match.index,match.index+match[0].length],parentRangeUtf8Bytes:[Buffer.byteLength(prefix),Buffer.byteLength(text.slice(0,match.index+match[0].length))],parentLine:prefix.split('\n').length,parentColumnUtf16:prefix.length-prefix.lastIndexOf('\n'),classification:'RAW_DIGIT_RUN_NO_NUMERIC_ACCEPTANCE'});}
  let semanticContext=null,compiled=null,hold=null;try{semanticContext=context(file,phase.ref);assert.equal(semanticContext.kind,'EXACT_PUBLIC_TS_CLOSED_UTF8_DOCUMENT_TEXT_CONSUMER','Unknown code-evaluating consumer context');compiled=compiledLiteralProof(text);assert(compiled.wholeGeneratedStringLiteralValues.includes(body?body+'\n':''),'Whole code-node value not retained as generated string literal');}catch(error){hold={file,...phase,kind:'HOLD_UNKNOWN_MDX_LITERAL_CONSUMER_OR_TRANSFORM',error:String(error.message),wholeOwnerSHA256:ownerSHA256,address};}
  const physicalLineBindings=[];let mappingHold=null;if(rawSpan!==null){const physical=rawSpan.split(/\r?\n/);const bodyLines=body.split('\n');if(physical.length===bodyLines.length+2&&physical.slice(1,-1).every((line,i)=>line===bodyLines[i])){let offset=node.position.start.offset+physical[0].length+(rawSpan[physical[0].length]==='\r'?2:1);for(let i=0;i<bodyLines.length;i++){physicalLineBindings.push({bodyLine:i+1,parentLine:node.position.start.line+i+1,parentStartUtf16:offset,fullRawLine:bodyLines[i]});offset+=physical[i+1].length+(text[offset+physical[i+1].length]==='\r'?2:1);}}else mappingHold={file,...phase,kind:'HOLD_MDX_CONTAINER_OR_DEDENT_RAW_LINE_MAPPING',address,allRawParentAndBodyStillPreserved:true};}else mappingHold={file,...phase,kind:'HOLD_MDX_RAW_PARENT_POSITION_MISSING',address};
  const strictSyntheticProgramPositionDiagnostics=[];
  if (/^(?:[cm]?[jt]sx?|javascript|typescript)$/.test(node.lang??'')) {
   const extension=node.lang==='javascript'?'js':node.lang==='typescript'?'ts':node.lang;
   const kind=/jsx$/.test(extension)?ts.ScriptKind.JSX:/tsx$/.test(extension)?ts.ScriptKind.TSX:/^[cm]?js$/.test(extension)?ts.ScriptKind.JS:ts.ScriptKind.TS;
   const program=ts.createSourceFile(file+'.'+extension,body,ts.ScriptTarget.Latest,true,kind);
   for(const diagnostic of program.parseDiagnostics){const offset=diagnostic.start??0,local=program.getLineAndCharacterOfPosition(offset),mapped=physicalLineBindings[local.line];let parentOffsetUtf16=null,parentLocation=null;
    if(mapped&&local.character<=mapped.fullRawLine.length){parentOffsetUtf16=mapped.parentStartUtf16+local.character;const prefix=text.slice(0,parentOffsetUtf16);parentLocation={line:prefix.split('\n').length,column:prefix.length-prefix.lastIndexOf('\n')};}
    strictSyntheticProgramPositionDiagnostics.push({code:diagnostic.code,message:ts.flattenDiagnosticMessageText(diagnostic.messageText,'\n'),completeOriginalProgramSHA256:sha(body),originalSegmentOffsetUtf16:offset,originalSegmentLine:local.line+1,originalSegmentColumn:local.character+1,parentOffsetUtf16,parentOffsetUtf8Bytes:parentOffsetUtf16===null?null:Buffer.byteLength(text.slice(0,parentOffsetUtf16)),parentLocation,context:'DOCUMENTARY_PROGRAM_DIAGNOSTIC_RETAINED_NOT_REAL_MDX_EXECUTION'});
   }
  }
  const row={file,...phase,address,kind:'MDX_CODE_LITERAL_DOCUMENTARY_AUDIT',wholeOwnerSHA256:ownerSHA256,wholeRawOwner:text,nodeType:node.type,language:node.lang??null,meta:node.meta??null,wholeBody:body,wholeBodySHA256:sha(body),rawParentSpanUtf16:node.position?[node.position.start.offset,node.position.end.offset]:null,rawParentSpan:rawSpan,originalMdxPosition:node.position??null,wholeOwnerEveryRawDigitRun:rawNumbers,physicalLineBindings,syntheticProgramDiagnostics:syntheticDiagnostics,strictSyntheticProgramPositionDiagnostics,allOriginalExtractedSlotsRetained:retainedSlots,consumerContext:semanticContext,actualPublicCompilerProof:compiled,hold,mappingHold,actualExecutableProgram:!hold&&!mappingHold?false:null,independentAcceptance:false};documents.push(row);return {provedDocumentaryLiteral:!hold&&!mappingHold,hold,mappingHold};
 }
 return {fence,documents,consumerContexts};
}
