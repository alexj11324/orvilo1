{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "orvilo-auth",
  "account_id": "d8f6630c7869111a5139bc5ed4d24ace",
  "main": "./build/worker/index.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./build/client",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  },
  "vars": {
    "AUTH_API_BASE": "https://orvilo.aspectlylabs.com",
    "AUTH_APP_HOME": "https://orvilo.aspectlylabs.com",
    // Clerk publishable key — public by design (embedded in every Clerk client bundle).
    "CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsuYXNwZWN0bHlsYWJzLmNvbSQ",
    "PORTAL_PRODUCT_ORIGIN": "https://orvilo.aspectlylabs.com"
  },
  "routes": [
    { "pattern": "accounts.aspectlylabs.com", "zone_name": "aspectlylabs.com", "custom_domain": true }
  ]
}
