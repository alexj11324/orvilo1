{
  "name": "@orvilo/agent-manager-runtime",
  "version": "1.0.0",
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "scripts": {
    "test": "vitest",
    "test:coverage": "vitest --coverage --silent='passed-only'",
    "test:update": "vitest -u",
    "type-check": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@orvilo/prompts": "workspace:*",
    "@orvilo/types": "workspace:*"
  },
  "devDependencies": {
    "type-fest": "^4.41.0"
  },
  "orviloTypecheck": {
    "project": "tsconfig.json",
    "mode": "check",
    "coverage": "full"
  }
}
