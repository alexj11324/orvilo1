# LobeChat Development Environment Configuration
# ⚠️ DO NOT USE THESE VALUES IN PRODUCTION!
#
# Dev infrastructure can run in two modes:
#
#   A. Cloud dev (recommended, no Docker Desktop required)
#      Point DATABASE_URL / REDIS_URL / S3_* at the shared remote preview
#      infrastructure — the same services backing Vercel Preview deployments.
#      Grab the values via `vercel env pull` after `vercel link`, or walk
#      through scripts/setup-cloud-dev.sh. Leave SEARXNG_URL unset unless you
#      need agent web search.
#
#   B. Local Docker fallback (integration debugging / self-host parity)
#      docker compose -f docker-compose/dev/docker-compose.yml up -d
#      then keep the localhost defaults shown below.

# Application
APP_URL=http://localhost:3010

# Allow access to private IP addresses (localhost services) in development
# https://lobehub.com/docs/self-hosting/environment-variables/basic#ssrf-allow-private-ip-address
SSRF_ALLOW_PRIVATE_IP_ADDRESS=1

# Secrets (pre-generated for development only)
KEY_VAULTS_SECRET=ww+0igxjGRAAR/eTNFQ55VmhQB5KE5trFZseuntThJs=
AUTH_SECRET=ww+0igxjGRAAR/eTNFQ55VmhQB5KE5trFZseuntThJs=

# Database (PostgreSQL)
#   Mode B (local Docker):
DATABASE_URL=postgresql://postgres:change_this_password_on_production@localhost:5432/lobechat
#   Mode A (cloud dev): postgresql://<user>:<pass>@<remote-paradedb-host>:5432/orvilo_preview?sslmode=require
DATABASE_DRIVER=node

# Redis
#   Mode B (local Docker):
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=lobechat
REDIS_TLS=0
#   Mode A (cloud dev): dedicated preview Redis on the remote infra host
#   (see .env.example.preview — plain TCP + strong password, TLS off because
#   the app's self-signed-cert path isn't supported by ioredis tls:true).
# REDIS_URL=redis://default:<password>@<host>:26379
# REDIS_PREFIX=orvilo-preview
# REDIS_TLS=0

# S3 Storage
#   Mode B (local Docker, RustFS):
S3_ACCESS_KEY_ID=admin
S3_SECRET_ACCESS_KEY=change_this_password_on_production
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=lobe
S3_ENABLE_PATH_STYLE=1
S3_SET_ACL=0
#   Mode A (cloud dev / Cloudflare R2):
# S3_ACCESS_KEY_ID=<r2-access-key-id>
# S3_SECRET_ACCESS_KEY=<r2-secret-access-key>
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET=orvilo-preview
# S3_SET_ACL=0

# LLM vision uses base64 to avoid S3 presigned URL issues in development
LLM_VISION_IMAGE_USE_BASE64=1

# Search (SearXNG) — optional. Local Docker instance below; leave unset in
# cloud dev mode unless a remote SearXNG has been deployed.
SEARXNG_URL=http://localhost:8180

# QStash (agent async workflows) — optional in local dev; without it agent
# runtime executes steps synchronously. Set to Upstash QStash credentials to
# exercise the real queue path:
# QSTASH_TOKEN=
# QSTASH_CURRENT_SIGNING_KEY=
# QSTASH_NEXT_SIGNING_KEY=

# Proxy (Optional)
# HTTP_PROXY=http://localhost:7890
# HTTPS_PROXY=http://localhost:7890

# AI Model API Keys (Required for chat functionality)
# ANTHROPIC_API_KEY=sk-ant-xxx
# ANTHROPIC_PROXY_URL=https://api.anthropic.com

# OPENAI_API_KEY=sk-xxx
# OPENAI_PROXY_URL=https://api.openai.com/v1
