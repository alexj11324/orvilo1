        const oldOrder = Math.sign(oldDecl.globalDeclarationOrder - otherOld.globalDeclarationOrder); const newOrder = Math.sign(newDecl.globalDeclarationOrder - otherNew.globalDeclarationOrder);
        if (oldOrder !== newOrder && !(oldDecl.property === otherOld.property && cssCanonical(oldDecl.value, 16, variables) === cssCanonical(otherOld.value, 16, variables))) row.cascadeHolds.push({ file: site.file, astSlot: site.astSlot, tokenIndex: site.tokenIndex, companionIndex: i, oldCompanion, currentCompanion, property: oldDecl.property, companionProperty: otherOld.property, oldOrder, newOrder });
      }
    }
    if (row.cascadeHolds.length) { row.status = 'HOLD'; compilerHolds.push({ pairId: pair.id, kind: 'POTENTIAL_SAME_LITERAL_CASCADE_ORDER_CHANGE', sites: row.cascadeHolds }); }
    compiledPairs.push(row);
  }
