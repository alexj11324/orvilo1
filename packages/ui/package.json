{
  "name": "@orvilo/ui",
  "version": "1.0.0",
  "private": true,
  "description": "Build-only entry that re-exports Orvilo's ReUI/shadcn components for design-system sync",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "scripts": {
    "build": "NODE_OPTIONS=--max-old-space-size=12288 tsdown && node scripts/build-css.mjs"
  },
  "devDependencies": {
    "tsdown": "^0.21.10",
    "typescript": "^6.0.3"
  }
}
