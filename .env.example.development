# Orvilo Development Environment Configuration
# ⚠️ DO NOT USE THESE VALUES IN PRODUCTION!
#
# Copy to `.env` (or `.env.development`) for local development. Values are
# pre-filled for the docker-compose dev stack — only replace what you changed.
#
# Required-vs-optional convention:
#   - "Required:" lines under each section name the variables the dev server
#     will not boot without; everything else is optional.
#   - `.records/env/*.env` files are GENERATED runtime state written by dev/e2e
#     scripts — never hand-edit them.

# #######################################
# ######### Application & Ports ##########
# #######################################
# Required: APP_URL

# Public base URL of the local dev server (matches `bun run dev` port 3010)
APP_URL=http://localhost:3010

# Optional: server-to-server base URL that bypasses CDN/proxy for internal
# calls (workflows, hooks). Falls back to APP_URL when unset.
# INTERNAL_APP_URL=http://localhost:3010

# #######################################
# ########## Security Settings ###########
# #######################################

# Allow access to private IP addresses (localhost services) in development
# https://orvilo.aspectlylabs.com/docs/self-hosting/environment-variables/basic#ssrf-allow-private-ip-address
SSRF_ALLOW_PRIVATE_IP_ADDRESS=1

# #######################################
# ######### Auth & Key-Vault #############
# #######################################
# Required: KEY_VAULTS_SECRET, AUTH_SECRET

# Secrets (pre-generated for development only)
KEY_VAULTS_SECRET=ww+0igxjGRAAR/eTNFQ55VmhQB5KE5trFZseuntThJs=
AUTH_SECRET=ww+0igxjGRAAR/eTNFQ55VmhQB5KE5trFZseuntThJs=

# #######################################
# ######### Server Database ##############
# #######################################
# Required: DATABASE_URL

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:change_this_password_on_production@localhost:5432/orvilo
DATABASE_DRIVER=node

# #######################################
# ########### Redis Settings #############
# #######################################
# Required: REDIS_URL

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=orvilo
REDIS_TLS=0

# #######################################
# #### S3 Object Storage Service #########
# #######################################
# Required for file storage features: S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY,
# S3_ENDPOINT, S3_BUCKET

# S3 Storage (RustFS)
S3_ACCESS_KEY_ID=admin
S3_SECRET_ACCESS_KEY=change_this_password_on_production
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=orvilo
S3_ENABLE_PATH_STYLE=1
S3_SET_ACL=0

# #######################################
# ######## Search & Mock Services ########
# #######################################
# Optional

# LLM vision uses base64 to avoid S3 presigned URL issues in development
LLM_VISION_IMAGE_USE_BASE64=1

# Search (SearXNG)
SEARXNG_URL=http://localhost:8180

# #######################################
# ############# Proxy (Optional) #########
# #######################################
# Optional

# HTTP_PROXY=http://localhost:7890
# HTTPS_PROXY=http://localhost:7890

# #######################################
# ######### AI Provider Service ##########
# #######################################
# Required for chat functionality: at least one provider API key

# ANTHROPIC_API_KEY=sk-ant-xxx
# ANTHROPIC_PROXY_URL=https://api.anthropic.com

# OPENAI_API_KEY=sk-xxx
# OPENAI_PROXY_URL=https://api.openai.com/v1
