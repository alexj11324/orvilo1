  "fixedBoundary": [
    "Workspace / Teams / Projects / Members / Permissions",
    "Tasks / graph / dispatch / review / automations",
    "Agent identity + ACP harness binding",
    "Agent Gateway / Device Gateway / local + remote execution control",
    "Desktop/Web parity",
    "Collaboration / presence / shared conversations",
    "GitHub / Linear integration",
    "Conversation/activity UI as control and presentation surface",
    "Auth / DB / storage / observability / required infra"
  ],
  "version": 1,
  "vocabulary": {
    "KEEP": "Inside the fixed product boundary; stays.",
    "REWRITE_FOR_ACP": "Capability stays but must be re-founded on ACP/harness contracts; legacy execution assumptions are removed.",
    "DELETE": "Outside the boundary; remove the full dependency closure (route/UI -> store -> API -> service -> package -> schema -> locale -> test -> docs).",
    "INVESTIGATE": "Disposition not yet provable from static evidence alone; requires an explicit owner, evidence, and follow-up before any deletion."
  }
}
